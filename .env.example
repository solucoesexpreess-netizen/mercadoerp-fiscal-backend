# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mercadoerp_fiscal

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Certificado A1 / armazenamento seguro
STORAGE_SECRET_KEY=change-this-to-a-strong-secret-32-bytes

# JWT (opcional: usa secret de desenvolvimento se não configurado)
# JWT_PRIVATE_KEY_PATH=./keys/private.pem
# JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
